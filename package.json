{
  "name": "@alergeek-ventures/opencode",
  "version": "0.0.1",
  "description": "AV's guidelines as a plugin for OpenCode",
  "author": "Alergeek-Ventures",
  "license": "MIT",
  "homepage": "https://github.com/Alergeek-Ventures/opencode-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alergeek-Ventures/opencode-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Alergeek-Ventures/opencode-plugin/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "coding-agent",
    "code-review"
  ],
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "av-reviewer": "./dist/cli.js"
  },
  "files": [
    "dist",
    "agent",
    "command"
  ],
  "scripts": {
    "build": "bun build src/index.ts --outfile dist/index.js --target bun --external @opencode-ai/plugin && bun build src/cli.ts --outfile dist/cli.js --target bun",
    "prepublishOnly": "bun run build"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.0.218"
  },
  "peerDependencies": {
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6"
  }
}
